local function zoneFromPart(part)
    if not part then return nil end
    local z = PART_TO_ZONE[part.Name]
    if z then return z end
    local low = part.Name:lower()
    if low:find("head") then return "Head" end
    if low:find("upper") or low:find("torso") then return "UpperTorso" end
    if low:find("lower") then return "LowerTorso" end
    if low:find("left") and (low:find("arm") or low:find("hand")) then return "LeftArm" end
    if low:find("right") and (low:find("arm") or low:find("hand")) then return "RightArm" end
    if low:find("left") and (low:find("leg") or low:find("foot")) then return "LeftLeg" end
    if low:find("right") and (low:find("leg") or low:find("foot")) then return "RightLeg" end
    return "UpperTorso"
end

local function guessHitZone(victim)
    local tgt = SILENT.target or SILENT.lastPart
    if tgt and tgt.Parent then
        local model = tgt:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) == victim then
            return zoneFromPart(tgt)
        end
    end
    local ch = victim.Character
    if ch then
        local attr = ch:GetAttribute("LastHitPart")
        if type(attr) == "string" and PART_TO_ZONE[attr] then
            return PART_TO_ZONE[attr]
        end
    end
    local myCh = lp.Character
    local myHrp = myCh and myCh:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position or (myHrp and myHrp.Position)
    if not (ch and origin) then return "UpperTorso" end
    local best, bestScore = "UpperTorso", math.huge
    for pname, zname in pairs(PART_TO_ZONE) do
        local part = ch:FindFirstChild(pname)
        if part then
            local to = part.Position - origin
            local m = to.Magnitude
            if m > 0.01 then
                local score = m
                if cam then
                    local ang = math.acos(math.clamp(cam.CFrame.LookVector:Dot(to / m), -1, 1))
                    score = ang * 8 + m * 0.05
                end
                if score < bestScore then
                    bestScore = score
                    best = zname
                end
            end
        end
    end
    return best
end

local function onEnemyDamaged(plr)
    if not HM.on or plr == lp then return end
    if not enPartida() then return end
    if not isEnemy(plr) then return end
    flashZone(guessHitZone(plr))
end

local function hookEnemyHealth(plr)
    if plr == lp then return end
    local function bind(ch)
        local hum = ch:WaitForChild("Humanoid", 8)
        if not hum then return end
        HM.lastHealth[plr] = hum.Health
        C(hum:GetPropertyChangedSignal("Health"), function()
            local cur = hum.Health
            local prev = HM.lastHealth[plr] or cur
            if cur < prev - 0.5 then
                onEnemyDamaged(plr)
            end
            HM.lastHealth[plr] = cur
        end)
        C(hum.Died, function()
            HM.lastHealth[plr] = 0
        end)
    end
    C(plr.CharacterAdded, function(ch)
        task.spawn(bind, ch)
    end)
    if plr.Character then
        task.spawn(bind, plr.Character)
    end
end

