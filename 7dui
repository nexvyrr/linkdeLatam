local FARM = {
    on = false,
    keys = { "coin", "pumpkin", "candy", "orb", "cash", "calabaza", "collect", "drop", "event" },
    skip = { "tele", "portal", "exit", "leave", "lobby", "kill", "lava", "damage", "void", "trap" },
    range = 60,
    interval = 0.1,
    retry = 6,
    hold = 0.05,
    delay = 4,
    since = nil,
    ready = nil,
}
local cache, lastTouch = {}, {}

local function inCharacter(p)
    local m = p:FindFirstAncestorOfClass("Model")
    while m do
        if m:FindFirstChildOfClass("Humanoid") then return true end
        m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function nameMatch(p)
    local s = (p.Name .. " " .. (p.Parent and p.Parent.Name or "") .. " " .. (p.Parent and p.Parent.Parent and p.Parent.Parent.Name or "")):lower()
    for _, k in ipairs(FARM.keys) do
        if s:find(k, 1, true) then return true end
    end
    return false
end

local function skipped(p)
    local s = p.Name:lower()
    for _, k in ipairs(FARM.skip) do
        if s:find(k, 1, true) then return true end
    end
    return false
end

local function addCoin(p)
    if cache[p] == nil and p:IsA("BasePart") and nameMatch(p) and not skipped(p) and not inCharacter(p) then
        cache[p] = true
    end
end

local function rescan()
    for _, d in ipairs(workspace:GetDescendants()) do addCoin(d) end
end

rescan()
C(workspace.DescendantAdded, function(d)
    addCoin(d)
    task.defer(addCoin, d)
end)
C(workspace.DescendantRemoving, function(d)
