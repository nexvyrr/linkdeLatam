local function fpsNukeFX(inst)
    if not inst then return end
    if inst:IsA("ParticleEmitter") then
        fpsSave(inst, "Enabled", inst.Enabled)
        fpsSave(inst, "Rate", inst.Rate)
        inst.Enabled = false
        inst.Rate = 0
    elseif inst:IsA("Trail") or inst:IsA("Beam") then
        fpsSave(inst, "Enabled", inst.Enabled)
        inst.Enabled = false
    elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
        fpsSave(inst, "Enabled", inst.Enabled)
        inst.Enabled = false
    elseif inst:IsA("Explosion") then
        inst.Visible = false
        inst.BlastPressure = 0
        inst.BlastRadius = 0
    elseif inst:IsA("BloomEffect") or inst:IsA("BlurEffect") or inst:IsA("ColorCorrectionEffect")
        or inst:IsA("SunRaysEffect") or inst:IsA("DepthOfFieldEffect") then
        fpsSave(inst, "Enabled", inst.Enabled)
        inst.Enabled = false
    elseif inst:IsA("Atmosphere") then
        fpsSave(inst, "Density", inst.Density)
        fpsSave(inst, "Glare", inst.Glare)
        fpsSave(inst, "Haze", inst.Haze)
        inst.Density = 0
        inst.Glare = 0
        inst.Haze = 0
    elseif inst:IsA("Clouds") then
        fpsSave(inst, "Enabled", inst.Enabled)
        inst.Enabled = false
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        if inst.Transparency < 0.3 then
            fpsSave(inst, "Transparency", inst.Transparency)
            inst.Transparency = math.max(inst.Transparency, 0.35)
        end
    end
end

