    local ep = ehrp.Position
    local feetY = enemyFeetY(ehum, ehrp)
    KILL.lastSafe = ep + Vector3.new(0, 3, 0)
    local pos = root.Position
    local ox, oz = pos.X - ep.X, pos.Z - ep.Z
    local om = math.sqrt(ox * ox + oz * oz)
    if om < 0.05 then
        local lv = ehrp.CFrame.LookVector
        ox, oz = -lv.X, -lv.Z
        om = math.sqrt(ox * ox + oz * oz)
        if om < 0.0001 then ox, oz, om = 0, 1, 1 end
    end
    ox, oz = ox / om, oz / om
    local y = math.max(feetY + KILL.lieY, ep.Y - 3.5)
    local goal = Vector3.new(ep.X + ox * KILL.near, y, ep.Z + oz * KILL.near)
    local delta = goal - pos
    local dist = delta.Magnitude
    local newPos = goal
    if dist > 0.05 then
        local step = math.min(dist, math.max(KILL.speed * dt, dist * (1 - math.exp(-20 * dt))))
        newPos = pos + delta.Unit * step
    end
    KILL.lastCF = CFrame.lookAt(newPos, newPos + Vector3.new(-ox, 0, -oz)) * CFrame.Angles(0, 0, math.rad(90))
    root.CFrame = KILL.lastCF
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end)

