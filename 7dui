end

local acc = 0
C(RunService.Heartbeat, function(dt)
    if not FARM.on then return end
    acc = acc + dt
    if acc < FARM.interval then return end
    acc = 0
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        FARM.since = nil
        return
    end
    local now = os.clock()
    if not (FARM.ready and FARM.ready(hum, hrp)) then
        FARM.since = nil
        return
    end
    FARM.since = FARM.since or now
    if now - FARM.since < FARM.delay then return end
    local pos = hrp.Position
    local best, bestD = nil, FARM.range
    for p in pairs(cache) do
        if p.Parent then
            if now - (lastTouch[p] or -1e9) >= FARM.retry and reachable(p) then
                local d = (p.Position - pos).Magnitude
                if d <= bestD then
                    best, bestD = p, d
                end
            end
        else
            cache[p] = nil
            lastTouch[p] = nil
        end
    end
    if best then
        lastTouch[best] = now
        task.spawn(touch, best, hrp)
    end
end)

