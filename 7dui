            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end
    end)
end

local function fpsSweepWorkspace()
    local hideMaps = workspace:FindFirstChild("HideMaps")
    local lobby = workspace:FindFirstChild("Lobby")
    local voting = workspace:FindFirstChild("VotingMap")

    local function stripModelFX(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            fpsNukeFX(d)
            if d:IsA("BasePart") then
                if d.Material == Enum.Material.Glass or d.Material == Enum.Material.ForceField then
                    fpsSave(d, "Material", d.Material)
                    d.Material = Enum.Material.SmoothPlastic
                end
                if d.Reflectance > 0.05 then
                    fpsSave(d, "Reflectance", d.Reflectance)
                    d.Reflectance = 0
                end
                if d.CastShadow then
                    fpsSave(d, "CastShadow", true)
                    d.CastShadow = false
                end
            end
        end
    end

    stripModelFX(lobby)
    stripModelFX(voting)
    stripModelFX(hideMaps)

    local running = workspace:FindFirstChild("RunningGames")
    if running then
        for _, d in ipairs(running:GetDescendants()) do
            fpsNukeFX(d)
        end
    end

    local skins = RS:FindFirstChild("Skins")
    if skins then
        for _, d in ipairs(skins:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                fpsNukeFX(d)
            end
        end
    end

    local effects = RS:FindFirstChild("Skins") and RS.Skins:FindFirstChild("Effects")
    if effects then
        for _, d in ipairs(effects:GetDescendants()) do
            fpsNukeFX(d)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = plr.Character
        if ch then
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                    if plr ~= lp then
                        fpsNukeFX(d)
                    else
                        if d:IsA("ParticleEmitter") and d.Rate > 20 then
                            fpsSave(d, "Rate", d.Rate)
                            d.Rate = math.min(d.Rate, 12)
                        end
                    end
                elseif d:IsA("BasePart") and d.CastShadow then
                    d.CastShadow = false
                end
            end
        end
    end

    for _, d in ipairs(workspace:GetChildren()) do
        if d.Name == "UwUPreview" then
            pcall(function() d:Destroy() end)
        end
    end
end

local function fpsSoftCharacters()
    local my = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not my then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - my.Position).Magnitude
                if dist > 120 then
                    for _, p in ipairs(ch:GetDescendants()) do
                        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                            if p.LocalTransparencyModifier < 0.5 then
                                p.LocalTransparencyModifier = 0.55
                            end
                        elseif p:IsA("Decal") or p:IsA("Texture") then
                            p.Transparency = math.max(p.Transparency, 0.5)
                        end
                    end
                elseif dist > 60 then
                    for _, p in ipairs(ch:GetDescendants()) do
                        if p:IsA("ParticleEmitter") or p:IsA("Trail") or p:IsA("Beam") then
                            fpsNukeFX(p)
                        end
                    end
                end
            end
        end
    end
end

local function fpsStart()
    if FPS.conn then return end
    FPS.on = true
    fpsApplySettings()
    fpsSweepWorkspace()

    FPS.descConn = workspace.DescendantAdded:Connect(function(d)
        if not FPS.on then return end
        task.defer(function()
            if FPS.on then fpsNukeFX(d) end
        end)
    end)

    FPS.conn = RunService.Heartbeat:Connect(function(dt)
        if not FPS.on then return end
        FPS.acc = FPS.acc + dt
        if FPS.acc < 1.25 then return end
        FPS.acc = 0
        pcall(fpsApplySettings)
        pcall(fpsSweepWorkspace)
        pcall(fpsSoftCharacters)
    end)
end

local function fpsRestore()
    for obj, props in pairs(FPS.saved) do
        if typeof(obj) == "Instance" and obj.Parent then
            for k, v in pairs(props) do
                pcall(function() obj[k] = v end)
            end
        end
    end
    FPS.saved = {}
end

local function fpsStop()
    FPS.on = false
    if FPS.conn then FPS.conn:Disconnect() FPS.conn = nil end
    if FPS.descConn then FPS.descConn:Disconnect() FPS.descConn = nil end
    pcall(fpsRestore)
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
    end)
end

local function fpsSet(v)
    if v then fpsStart() else fpsStop() end
end


